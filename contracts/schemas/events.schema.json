{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EventsSchema",
  "type": "object",
  "required": ["contract_version", "mock", "events"],
  "properties": {
    "contract_version": { "type": "string", "enum": ["1.0"] },
    "mock": { "type": "boolean" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "name", "is_no_storm", "bbox", "grid",
          "first_issue", "last_issue", "issue_step_min",
          "leads_min", "event_thr_mm_h", "reference", "points"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "is_no_storm": { "type": "boolean" },
          "bbox": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "grid": {
            "type": "object",
            "required": ["res_deg", "nx", "ny"],
            "properties": {
              "res_deg": { "type": "number" },
              "nx": { "type": "integer" },
              "ny": { "type": "integer" }
            }
          },
          "first_issue": { "type": "string" },
          "last_issue": { "type": "string" },
          "issue_step_min": { "type": "integer" },
          "leads_min": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "event_thr_mm_h": { "type": "number" },
          "reference": {
            "type": "object",
            "required": ["label", "url", "verified"],
            "properties": {
              "label": { "type": "string" },
              "url": { "type": "string" },
              "verified": { "type": "boolean" }
            }
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "lat", "lon"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "lat": { "type": "number" },
                "lon": { "type": "number" }
              }
            }
          }
        }
      }
    }
  }
}
