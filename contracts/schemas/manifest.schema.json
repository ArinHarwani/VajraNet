{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ManifestSchema",
  "type": "object",
  "required": [
    "contract_version", "event_id", "image_coordinates",
    "image_projection", "colormap", "obs", "forecast"
  ],
  "properties": {
    "contract_version": { "type": "string", "enum": ["1.0"] },
    "event_id": { "type": "string" },
    "image_coordinates": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "number" },
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 4,
      "maxItems": 4
    },
    "image_projection": { "type": "string", "enum": ["web-mercator-resampled"] },
    "colormap": { "type": "string" },
    "obs": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "forecast": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["mean", "prob"],
          "properties": {
            "mean": { "type": "string" },
            "prob": { "type": "string" }
          }
        }
      }
    }
  }
}
